{
  "name": "@cryptorill/web-components",
  "version": "1.0.0",
  "description": "Framework-agnostic Web Components for crypto prices, markets, portfolios, and transactions. Built with Stencil.",
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "CryptoRill",
    "email": "dev@cryptorill.com",
    "url": "https://github.com/cryptorill"
  },
  "homepage": "https://github.com/cryptorill/web-components#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cryptorill/web-components.git"
  },
  "bugs": {
    "url": "https://github.com/cryptorill/web-components/issues"
  },
  "keywords": [
    "cryptocurrency",
    "crypto",
    "web-components",
    "custom-elements",
    "stencil",
    "design-system",
    "trading",
    "market-data",
    "ui-components",
    "typescript"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/tree-shakeable/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/cryptorill-web-components/cryptorill-web-components.esm.js",
  "jsdelivr": "dist/cryptorill-web-components/cryptorill-web-components.esm.js",
  "exports": {
    ".": {
      "types": "./dist/tree-shakeable/index.d.ts",
      "import": "./dist/tree-shakeable/index.js",
      "require": "./dist/cjs/index.cjs.js",
      "default": "./dist/tree-shakeable/index.js"
    },
    "./register": {
      "types": "./loader/index.d.ts",
      "import": "./dist/cryptorill-web-components/cryptorill-web-components.esm.js",
      "require": "./dist/cjs/cryptorill-web-components.cjs.js",
      "default": "./dist/cryptorill-web-components/cryptorill-web-components.esm.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js",
      "default": "./loader/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./components/*.js": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./tree-shakeable": {
      "types": "./dist/tree-shakeable/index.d.ts",
      "import": "./dist/tree-shakeable/index.js",
      "default": "./dist/tree-shakeable/index.js"
    },
    "./tree-shakeable/*.js": {
      "types": "./dist/tree-shakeable/*.d.ts",
      "import": "./dist/tree-shakeable/*.js",
      "default": "./dist/tree-shakeable/*.js"
    },
    "./tree-shakeable/*": {
      "types": "./dist/tree-shakeable/*.d.ts",
      "import": "./dist/tree-shakeable/*.js",
      "default": "./dist/tree-shakeable/*.js"
    },
    "./styles.css": "./dist/cryptorill-web-components/cryptorill-web-components.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/components/**",
    "./dist/cryptorill-web-components/**",
    "./dist/cjs/**",
    "./dist/esm/**",
    "./loader/**",
    "./dist/**/*.css"
  ],
  "files": [
    "dist/",
    "loader/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "clean": "node -e \"const fs=require('node:fs');for(const d of ['dist','loader','www','.stencil','playwright-report','test-results'])fs.rmSync(d,{recursive:true,force:true})\"",
    "clean:dist": "node -e \"const fs=require('node:fs');for(const d of ['dist','loader'])fs.rmSync(d,{recursive:true,force:true})\"",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "bun test src/utils/*.spec.ts src/core/**/*.spec.ts",
    "test:unit:watch": "bun test --watch src/utils/*.spec.ts src/core/**/*.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:watch": "playwright test --watch",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "pack:check": "npm pack --dry-run",
    "prepack": "bun run clean:dist && bun run build",
    "prepublishOnly": "bun run test:unit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@angular/core": "^21.2.6",
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.40.0",
    "@stencil/angular-output-target": "^1.3.0",
    "@stencil/core": "^4.43.3",
    "@stencil/playwright": "^0.2.3",
    "@stencil/react-output-target": "^1.4.2",
    "@stencil/vue-output-target": "^0.13.1",
    "@types/bun": "^1.3.11",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "jest-cli": "^30.3.0",
    "puppeteer": "^24.40.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rxjs": "^7.8.2",
    "solid-js": "^1.9.12",
    "vue": "^3.5.31"
  }
}